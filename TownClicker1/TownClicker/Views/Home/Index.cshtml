@{
    ViewData["Title"] = "Home Page";
}

<!DOCTYPE html>
<html>

<head>
    <meta charset='utf-8'>
    <title>Town Clicker</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel='stylesheet' type='text/css' media='screen' href="css/main.css">
    <link rel='stylesheet' type='text/css' media='screen' href="css/menu.css">
    <link rel='stylesheet' type='text/css' media='screen' href="css/field.css">
</head>

<body>
<main>
    <div id="grid-container">
        <div id="grid-wrapper">
            <div id="grid"></div>
        </div>
    </div>
</main>

<header>
    <div class="header-left">
        <div class="header-left-top">
            <div class="level-box"><span id="level-value">1</span></div>
            <span class="resources-item">
                <img class="resources-icon" src="images/coin.png" alt="Coins" width="24">
                <span id="coin-count">1000</span>
            </span>
            <span class="resources-item">
                <img class="resources-icon" src="images/people.png" alt="Clicks" width="24">
                <span id="click-count">0</span>
                @if (User.Identity is { IsAuthenticated: true })
                {
                    <script>
                        async function loadBalance() {
                            try {
                                const clicks = document.getElementById('click-count');
                                const response = await fetch('http://localhost:5045/api/Statistics');
                                if (!response.ok) {
                                    throw new Error('Ошибка HTTP: ' + response.status);
                                }
                                const money = await response.text();
                                clicks.textContent = money;
                            } catch (error) {
                                console.error('Ошибка:', error);
                            }
                        }

                        loadBalance();
                    </script>
                }
            </span>
        </div>
        <div class="progress-bar">
            <div class="progress-bar-progress" id="progress-bar-value" style="width:30%"></div>
        </div>
    </div>
    <div class="header-center" id="header-center" style="display: none">
        <div id="upgrade-notification" class="upgrade-popup">
            <img id="upgrade-image" alt='улучшение' src=''>
            <div>Улучшение <span id="upgrade-name"></span> активно! Осталось <span id="upgrade-timer">10</span> сек.</div>
            <div class="progress-container">
                <div id="upgrade-progress" class="progress-bar"></div>
            </div>
        </div>
    </div>
    <div class="header-right">
        <a asp-controller="Account" asp-action="Login">
            @if (User.Identity is { IsAuthenticated: true })
            {
                <span>@User.Identity.Name</span>
            }
            <img class="menu-icon" src="images/user.png" alt="User" width="24">
        </a>
    </div>
</header>

<footer>
    <div class="footer-left">
        <div class="footer-row">
            <img class="menu-icon" src="images/shop.png" alt="Shop" onclick="openMenu('Магазин')">
        </div>
        <div class="footer-row">
            <img class="menu-icon" src="images/chest.png" alt="Chest" onclick="openMenu('Инвентарь', '@User.Identity.Name')">
        </div>
    </div>
    <button class="click-button">ТЫК</button>
    <div class="footer-right">
        <div class="footer-row">
            <img class="menu-icon" src="images/rank.png" alt="Rank" onclick="openMenu('Рейтинг', '@User.Identity.Name')">
        </div>
    </div>
</footer>

<div class="menu-overlay" id="menu-overlay" style="display: none;">
    <div class="menu">
        <button class="menu-close-btn" onclick="closeMenu()">×</button>
        <h2 class="menu-title" id="menu-title-text">Menu</h2>
        <div id="menu-content">
            <div id="inventory-grid" style="display: none;"></div>
            <table id="rating-table" style="display: none;"></table>
        </div>
    </div>
</div>

<template id="market-item-template">
    <div class="market-item">
        <div class="market-item-level">Уровень <span class="market-item-level-value"></span></div>
        <div class="market-item-img-container">
            <img class="market-item-img">
        </div>
        <div class="market-item-cost-value"></div>
        <div class="market-item-info">
            +<span class="market-item-info-current-value"></span>
            <span class="market-item-info-next">
                -&gt;
                +<span class="market-item-info-next-value"></span>
            </span>
        </div>
    </div>
</template>

<script src="js/menu.js"></script>
<script src="js/engine.js"></script>
<script src="js/clicks.js"></script>
<script src="js/improvement.js"></script>
</body>

</html>