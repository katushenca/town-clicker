@using TownClicker.ViewModels
@model RegisterViewModel

@{
    ViewData["Title"] = "Регистрация";
}

<!DOCTYPE html>
<html>

<head>
    <meta charset='utf-8'>
    <title>Town Clicker</title>
    <link rel='stylesheet' type='text/css' media='screen' href="/css/login.css">
</head>

<body>
<div class="register-container">
    <div>
        <p>
            <h2>Регистрация</h2>
        </p>

        @if(!ViewData.ModelState.IsValid)
        {
            <div class="text-danger">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p class="error-message">@error.ErrorMessage</p>
                }
            </div>
        }

        <div>
            <div>
                <form asp-action="Register">
                    <div class="form-fields">
                        <label asp-for="Email"></label>
                        <input asp-for="Email"/>
                        <span class="field-validation" asp-validation-for="Email"></span>
                    </div>
                    <div class="form-fields">
                        <label asp-for="Username"></label>
                        <input asp-for="Username" />
                        <span class="field-validation" asp-validation-for="Username"></span>
                    </div>
                    <div class="form-fields">
                        <label asp-for="Password"></label>
                        <input asp-for="Password"/>
                        <span class="field-validation" asp-validation-for="Password"></span>
                    </div>
                    <div class="form-fields">
                        <label asp-for="ConfirmPassword"></label>
                        <input asp-for="ConfirmPassword"/>
                        <span class="field-validation" asp-validation-for="ConfirmPassword"></span>
                    </div>

                    <div class="click-button">
                        <input type="submit" value="Зарегистрироваться" />
                        <a class="cancel-button" asp-controller="Home" asp-action="Index">Отмена</a>
                    </div>
                    <div class="bottom-links">
                        <a asp-controller="Account" asp-action="Login">Авторизация</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
</body>